{
  "name": "pidge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.mjs --watch",
    "build": "node esbuild.mjs && vite build",
    "build:webview": "vite build",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@api-client/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "displayName": "pidge",
  "description": "Type a URL, press Send. A local-first HTTP client inside VS Code.",
  "publisher": "apiclient",
  "icon": "media/pidge.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Geevo/pidge"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onWebviewPanel:pidge.request"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pidge.newRequest",
        "title": "New Request",
        "category": "pidge",
        "icon": "$(add)"
      },
      {
        "command": "pidge.open",
        "title": "Open",
        "category": "pidge"
      },
      {
        "command": "pidge.importSaved",
        "title": "Import Saved Requests…",
        "category": "pidge"
      },
      {
        "command": "pidge.exportSaved",
        "title": "Export Saved Requests…",
        "category": "pidge"
      },
      {
        "command": "pidge.clearHistory",
        "title": "Clear History",
        "category": "pidge",
        "icon": "$(clear-all)"
      },
      {
        "command": "pidge.restartSidecar",
        "title": "Restart Request Engine",
        "category": "pidge"
      },
      {
        "command": "pidge.openSaved",
        "title": "Open",
        "category": "pidge"
      },
      {
        "command": "pidge.openHistory",
        "title": "Open",
        "category": "pidge"
      },
      {
        "command": "pidge.deleteSaved",
        "title": "Delete",
        "category": "pidge",
        "icon": "$(trash)"
      },
      {
        "command": "pidge.deleteHistoryEntry",
        "title": "Delete",
        "category": "pidge",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pidge",
          "title": "pidge",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "pidge": [
        {
          "id": "pidge.sidebar",
          "name": "pidge",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pidge.importSaved",
          "when": "view == pidge.sidebar",
          "group": "1_transfer@1"
        },
        {
          "command": "pidge.exportSaved",
          "when": "view == pidge.sidebar",
          "group": "1_transfer@2"
        },
        {
          "command": "pidge.clearHistory",
          "when": "view == pidge.sidebar",
          "group": "2_history"
        }
      ],
      "webview/context": [
        {
          "command": "pidge.openSaved",
          "when": "webviewId == 'pidge.sidebar' && webviewSection == 'saved'",
          "group": "1_open"
        },
        {
          "command": "pidge.exportSaved",
          "when": "webviewId == 'pidge.sidebar' && webviewSection == 'saved'",
          "group": "2_transfer"
        },
        {
          "command": "pidge.deleteSaved",
          "when": "webviewId == 'pidge.sidebar' && webviewSection == 'saved'",
          "group": "3_delete"
        },
        {
          "command": "pidge.openHistory",
          "when": "webviewId == 'pidge.sidebar' && webviewSection == 'history'",
          "group": "1_open"
        },
        {
          "command": "pidge.deleteHistoryEntry",
          "when": "webviewId == 'pidge.sidebar' && webviewSection == 'history'",
          "group": "3_delete"
        }
      ],
      "commandPalette": [
        {
          "command": "pidge.openSaved",
          "when": "false"
        },
        {
          "command": "pidge.openHistory",
          "when": "false"
        },
        {
          "command": "pidge.deleteSaved",
          "when": "false"
        },
        {
          "command": "pidge.deleteHistoryEntry",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "pidge",
      "properties": {
        "pidge.sidecarPath": {
          "type": "string",
          "default": "",
          "description": "Path to a request engine binary. Leave empty to use the one bundled with the extension."
        },
        "pidge.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log protocol traffic to the pidge output channel. Secret header values are never logged."
        }
      }
    }
  }
}
