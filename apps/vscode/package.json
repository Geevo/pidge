{
  "name": "pidge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.mjs --watch",
    "build": "node esbuild.mjs && vite build",
    "build:webview": "vite build",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@api-client/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "displayName": "pidge",
  "description": "Type a URL, press Send. A local-first HTTP client inside VS Code.",
  "publisher": "apiclient",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "pidge.open",
        "title": "Open",
        "category": "pidge"
      },
      {
        "command": "pidge.newRequest",
        "title": "New Request",
        "category": "pidge"
      },
      {
        "command": "pidge.restartSidecar",
        "title": "Restart Request Engine",
        "category": "pidge"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pidge",
          "title": "pidge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pidge": [
        {
          "id": "pidge.launcher",
          "name": "pidge",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "pidge",
      "properties": {
        "pidge.sidecarPath": {
          "type": "string",
          "default": "",
          "description": "Path to a request engine binary. Leave empty to use the one bundled with the extension."
        },
        "pidge.trace": {
          "type": "boolean",
          "default": false,
          "description": "Log protocol traffic to the pidge output channel. Secret header values are never logged."
        }
      }
    }
  }
}
