{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pidge",
  "mainBinaryName": "pidge",
  "version": "0.1.0",
  "identifier": "io.github.geevo.pidge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @api-client/desktop dev:web",
    "beforeBuildCommand": "pnpm --filter @api-client/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "pidge",
        "width": 1100,
        "height": 740,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../packages/ui/src/fonts/IBMPlexSans-LICENSE.txt": "licenses/IBMPlexSans-LICENSE.txt",
      "../../../packages/ui/src/fonts/IBMPlexMono-LICENSE.txt": "licenses/IBMPlexMono-LICENSE.txt",
      "../../../THIRD-PARTY-LICENSES.md": "licenses/THIRD-PARTY-LICENSES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Geevo",
    "category": "DeveloperTool",
    "shortDescription": "A local-first HTTP client.",
    "longDescription": "Type a URL, press Send. No accounts, no cloud, no workspace."
  }
}
